{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@budgefi/domain": ["packages/domain/src/index.ts"],
      "@budgefi/contracts": ["packages/contracts/src/index.ts"],
      "@budgefi/database": ["packages/database/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "src"]
}
