DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/budgefi
# Production API/worker processes must use a separate LOGIN role that can SET ROLE
# to budgefi_app; never give the runtime migration-owner credentials.
# RUNTIME_DATABASE_URL=postgresql://budgefi_runtime:password@db.internal/budgefi
# The worker uses a separate LOGIN role that is only a member of
# budgefi_worker, never budgefi_app or the migration-owner role.
# WORKER_DATABASE_URL=postgresql://budgefi_worker_runtime:password@db.internal/budgefi
ALLOW_DEV_AUTH=true
ALLOW_USER_PROVISIONING=true
API_HOST=0.0.0.0
API_PORT=4422
WEB_ORIGIN=http://localhost:4411,http://127.0.0.1:4411
LOG_LEVEL=info
DB_POOL_SIZE=10
# Keep cloud staging explicit so Plaid Sandbox can run with production runtime
# hardening. Omit in local development; use production for live Plaid traffic.
# BUDGEFI_ENV=staging

# Clerk: `clerk init --app <app_id>` and `clerk env pull` create .env.local.
# Production requires a backend verification key plus explicit authorized origins
# and refuses ALLOW_DEV_AUTH. Never expose CLERK_SECRET_KEY in a VITE_ variable.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_or_live
# CLERK_SECRET_KEY=sk_test_or_live
# Required by POST /v1/clerk/webhook for verified identity-deletion reconciliation.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_example
# Alternatively, use Clerk's PEM public key for networkless verification:
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."
# CLERK_AUTHORIZED_PARTIES=https://app.budgefi.example
# VITE_PUBLIC_APP_URL=https://budgefi.com
# VITE_ROUTER_MODE=browser
# Native builds require public HTTPS origins; localhost and relative API paths
# do not work from an installed app.
# VITE_NATIVE_API_BASE_URL=https://api.budgefi.example/v1
# Exact hosted auth route. Hash-router deployments can use
# https://budgefi.com/#/native-auth
# VITE_NATIVE_AUTH_URL=https://budgefi.com/native-auth
# PUBLIC_APP_URL=https://app.budgefi.example

# Real Plaid Sandbox is opt-in. Generate a local-only key with:
# openssl rand -base64 32
# PLAID_ENABLED=true
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_secret
# PLAID_TOKEN_ENCRYPTION_KEY=
# PLAID_ACTIVE_TOKEN_KEY_ID=local-v1
# PLAID_WEBHOOK_URL=https://your-tunnel.example/v1/plaid/webhook
# Plaid OAuth must return to a registered HTTPS universal link.
# PLAID_REDIRECT_URI=https://budgefi.com/open/plaid-oauth
# PLAID_NATIVE_COMPLETION_URI=budgefi://open/plaid-complete

# Optional onboarding pattern classification. Budgefi falls back to its local
# recurrence engine when this is absent or disabled.
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_FINANCE_ENABLED=true
# OPENAI_FINANCE_MODEL=gpt-5.4-mini

# Notification delivery. The token key is a base64-encoded 32-byte key.
# NOTIFICATION_TOKEN_ENCRYPTION_KEY=
# NOTIFICATION_TOKEN_ACTIVE_KEY_ID=notifications-v1
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_TOPIC=com.budgefi.app
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_ENV=production
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=Budgefi <alerts@budgefi.example>
