{
  "name": "budgefi-mobile-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:api": "tsx watch --tsconfig tsconfig.backend.json apps/api/src/main.ts",
    "start:api": "tsx --tsconfig tsconfig.backend.json apps/api/src/main.ts",
    "start:worker": "tsx --tsconfig tsconfig.backend.json apps/worker/src/main.ts",
    "start:worker:once": "WORKER_RUN_MODE=once tsx --tsconfig tsconfig.backend.json apps/worker/src/main.ts",
    "start:plaid-worker": "PLAID_WORKER_DISABLED=true tsx --tsconfig tsconfig.backend.json apps/plaid-worker/src/main.ts",
    "build": "tsc -b && vite --config vite.config.ts build",
    "build:netlify": "node scripts/generate-app-links.mjs --if-configured && npm run build",
    "build:native": "VITE_ROUTER_MODE=hash vite --config vite.config.ts build && npx cap sync",
    "native:sync": "npm run build:native",
    "native:ios": "npm run build:native && npx cap open ios",
    "native:android": "npm run build:native && npx cap open android",
    "native:doctor": "npx cap doctor",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node scripts/generate-brand-assets.mjs --check",
    "app-links:generate": "node scripts/generate-app-links.mjs",
    "app-links:check": "node scripts/generate-app-links.mjs --check",
    "build:backend": "tsc -p tsconfig.backend.json --noEmit",
    "build:backend:emit": "tsc -p tsconfig.backend.build.json",
    "preview": "vite --config vite.config.ts preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.backend.json --noEmit --pretty false",
    "db:migrate": "tsx --tsconfig tsconfig.backend.json apps/api/src/database/migrate.ts",
    "db:bootstrap-runtime-roles": "tsx --tsconfig tsconfig.backend.json apps/api/src/database/bootstrap-runtime-roles.ts",
    "db:seed": "tsx --tsconfig tsconfig.backend.json apps/api/src/database/seed.ts",
    "test": "vitest run packages/domain/test test/unit",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:direct": "vitest run test/migration.integration.test.ts test/api.integration.test.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:plaid:sandbox": "node scripts/test-plaid-sandbox.mjs",
    "test:watch": "vitest",
    "check": "npm run brand:check && npm run typecheck && npm test && npm run test:integration && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@budgefi/capacitor-system-session": "file:packages/capacitor-system-session",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/privacy-screen": "^2.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@clerk/backend": "^3.16.13",
    "@clerk/react": "^6.14.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "5.12.1",
    "jose": "6.2.10",
    "kysely": "0.29.5",
    "lucide-react": "^0.468.0",
    "openai": "^6.49.0",
    "pg": "8.23.0",
    "pg-boss": "12.29.0",
    "plaid": "46.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plaid-link": "^5.0.0",
    "react-router-dom": "^7.8.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "^2.6.0",
    "uuid": "14.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@nestjs/testing": "12.0.1",
    "@types/node": "^22.10.2",
    "@types/pg": "8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "node-pg-migrate": "9.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.13",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "4.1.11"
  }
}
